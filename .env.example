# Ollama ejecuta el LLM en tu equipo. No necesita clave de OpenAI/Anthropic.
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434

# false conserva el clima SIMULADO del notebook del profesor.
# true consulta Open-Meteo en tiempo real (necesita Internet).
CLIMA_REAL=false

# Configura esto DESPUÉS de crear tu cuenta/clave de LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# LangSmith ACTUAL: crea un agente en LangSmith y copia su ID.
# Si tu workspace usa "Agents", descomenta y completa:
# LANGSMITH_AGENT_ID=taller-gemma-local
# LANGSMITH_AGENT_ENVIRONMENT=local

# LangSmith CLÁSICO con proyectos: usa lo siguiente en vez de AGENT_ID.
# LANGSMITH_PROJECT=tutorial-gemma-local

# Si tu cuenta está en la región EU/APAC, configura el endpoint correcto.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
